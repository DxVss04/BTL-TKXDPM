PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/di_cho_tien_loi
JWT_SECRET=doi_chuoi_nay_thanh_bi_mat_cua_nhom
JWT_REFRESH_SECRET=doi_chuoi_nay_nua
ACCESS_TOKEN_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=7d
# Để trống SMTP thì mã xác thực sẽ in ra console và trả về trong response (chế độ dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NODE_ENV=development
# Số ngày trước khi hết hạn thì gửi nhắc nhở
EXPIRY_REMIND_DAYS=3
# Trợ lý AI (Claude). Lấy khóa tại https://platform.claude.com -> API Keys. Để trống thì tính năng chat báo "chưa cấu hình".
ANTHROPIC_API_KEY=
# Tùy chọn: model và mức suy nghĩ (low | medium | high)
CHATBOT_MODEL=claude-opus-5-5
CHATBOT_EFFORT=low
